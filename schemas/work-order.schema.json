{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tigeriq.dev/schemas/work-order.schema.json",
  "title": "Work Order", "type": "object", "additionalProperties": false,
  "required": ["id", "title", "status", "owner", "acceptanceCriteria", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^WO-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "APPROVED", "IN_PROGRESS", "IMPLEMENTED", "GATE_PENDING", "VERIFIED", "REJECTED", "BLOCKED"] },
    "owner": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
