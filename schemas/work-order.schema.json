{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tigeriq.dev/schemas/work-order.schema.json",
  "title": "TigerIQ Work Order",
  "type": "object",
  "required": ["id", "project", "goal", "scope", "invariants", "acceptanceCriteria", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "edgeCases": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "string"},
    "status": {"enum": ["draft", "approved", "running", "failed", "blocked", "verified"]}
  },
  "additionalProperties": false
}
