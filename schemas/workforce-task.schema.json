{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tigeriq.local/schemas/workforce-task.schema.json",
  "title": "TigerIQ Workforce Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "idempotencyKey", "objective", "priority", "requiredCapabilities", "constraints", "inputs", "expectedArtifacts", "deadline", "maxAttempts", "reviewPolicy"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "department": { "type": "string" },
    "team": { "type": "string" },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "requiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": {}
        }
      }
    },
    "expectedArtifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "deadline": { "type": "string", "format": "date-time" },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independentReview", "judgeRequired", "preferProviderDiversity"],
      "properties": {
        "independentReview": { "type": "boolean" },
        "judgeRequired": { "type": "boolean" },
        "preferProviderDiversity": { "type": "boolean" }
      }
    }
  }
}
