{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tigeriq.local/schemas/ai-inference-gateway-v1.schema.json",
  "title": "TigerIQ AI Inference Gateway v1",
  "type": "object",
  "$defs": {
    "role": {
      "type": "string",
      "enum": ["executor", "reviewer", "judge"]
    },
    "taskKind": {
      "type": "string",
      "enum": ["general", "coding", "analysis", "research"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "sessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["employeeId", "nodeId", "requestedScopes", "client"],
      "properties": {
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nodeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requestedScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "const": "inference:invoke" }
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "sessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "session"],
      "properties": {
        "ok": { "const": true },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accessToken", "tokenType", "employeeId", "nodeId", "scopes", "expiresAt"],
          "properties": {
            "accessToken": { "type": "string", "minLength": 16 },
            "tokenType": { "const": "Bearer" },
            "employeeId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "nodeId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "scopes": {
              "type": "array",
              "items": { "const": "inference:invoke" }
            },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "inferenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "employeeId", "role", "task", "routing", "budgetClass"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "$ref": "#/$defs/role" },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "risk", "prompt"],
          "properties": {
            "kind": { "$ref": "#/$defs/taskKind" },
            "risk": { "$ref": "#/$defs/risk" },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 200000 },
            "acceptanceCriteria": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "minQuality": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredDistinctFrom"],
          "properties": {
            "requiredDistinctFrom": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9_-]+/.+$" }
            },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 }
          }
        },
        "budgetClass": { "const": "free-first" }
      }
    },
    "attemptEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "backendIdentity", "outcome", "failureKind"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "backendIdentity": { "type": "string", "minLength": 3, "maxLength": 256 },
        "outcome": { "type": "string", "enum": ["success", "failure"] },
        "failureKind": {
          "type": ["string", "null"],
          "enum": ["quota", "outage", "timeout", "auth", "invalid_response", "configuration", "budget", "health", null]
        }
      }
    },
    "inferenceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "requestId", "employee", "result", "evidence"],
      "properties": {
        "ok": { "const": true },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "employee": {
          "type": "object",
          "additionalProperties": false,
          "required": ["employeeId"],
          "properties": {
            "employeeId": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "decision"],
          "properties": {
            "text": { "type": "string" },
            "decision": { "type": ["string", "null"], "enum": ["PASS", "FAIL", null] }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selectedBackendIdentity", "attempts", "outputSha256", "budget", "gatewayVersion"],
          "properties": {
            "selectedBackendIdentity": { "type": "string", "minLength": 3, "maxLength": 256 },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/attemptEvidence" }
            },
            "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "consumedUnits", "remainingUnits"],
              "properties": {
                "class": { "const": "free-first" },
                "consumedUnits": { "type": "integer", "minimum": 0 },
                "remainingUnits": { "type": "integer", "minimum": 0 }
              }
            },
            "gatewayVersion": { "const": "v1" }
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "retryAfterMs"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "UNAUTHORIZED",
                "TOKEN_EXPIRED",
                "SCOPE_DENIED",
                "IDENTITY_MISMATCH",
                "INDEPENDENT_BACKEND_UNAVAILABLE",
                "GATEWAY_BUDGET_EXHAUSTED",
                "ROUTES_EXHAUSTED",
                "PROVIDER_UNAVAILABLE"
              ]
            },
            "message": { "type": "string", "maxLength": 256 },
            "retryable": { "type": "boolean" },
            "retryAfterMs": { "type": ["integer", "null"], "minimum": 0 },
            "attempts": {
              "type": "array",
              "maxItems": 3,
              "items": { "$ref": "#/$defs/attemptEvidence" }
            }
          }
        }
      }
    }
  }
}