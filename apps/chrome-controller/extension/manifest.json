{
  "manifest_version": 3,
  "name": "TigerIQ Chrome Controller",
  "version": "1.1.0",
  "description": "Window-bound TigerIQ browser worker bridge",
  "permissions": ["storage", "tabs", "windows", "alarms", "system.display"],
  "host_permissions": [
    "http://127.0.0.1:8798/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "TigerIQ Chrome Controller" }
}
