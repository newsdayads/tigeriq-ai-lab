<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="TigerIQ Camera Avatar"
                android:src="@drawable/ic_car_reverse_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trung tâm Điều khiển &amp; Cấu hình Toàn diện (DeX Edition)"
                    android:textColor="#00E5FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Quick Action Header Buttons -->
            <Button
                android:id="@+id/btnQuickToggleFloating"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:text="Bật Nút Nổi"
                android:textColor="#00E5FF"
                app:strokeColor="#00E5FF" />

            <Button
                android:id="@+id/btnOpenCamera"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#00E5FF"
                android:text="MỞ CAMERA"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 1: 3 CARDS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="14dp">

            <!-- CARD 1: CẤP QUYỀN HỆ THỐNG -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. CẤP QUYỀN HỆ THỐNG"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Camera Perm -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quyền truy cập Camera"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvCameraPermStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang kiểm tra…"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />
                <Button
                    android:id="@+id/btnGrantCamera"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#00E5FF"
                    android:text="Cấp quyền Camera"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <!-- Overlay Perm -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quyền hiển thị Nút nổi (Overlay)"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvOverlayPermStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang kiểm tra…"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />
                <Button
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#00E5FF"
                    android:text="Cấp quyền Nút nổi"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <!-- Notification Perm -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quyền chạy nền liên tục"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvNotificationPermStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang kiểm tra…"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />
                <Button
                    android:id="@+id/btnGrantNotification"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#00E5FF"
                    android:text="Cấp quyền Thông báo"
                    android:textColor="#000000"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- CARD 2: THIẾT BỊ CAMERA USB (AFN_CAP) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. THIẾT BỊ CAMERA USB"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRefreshUsb"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Quét lại"
                        android:textColor="#00E5FF"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutUsbDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNoUsbDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chưa phát hiện thiết bị USB nào cắm vào cổng."
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:paddingVertical="12dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1A00E5FF"
                    android:padding="8dp"
                    android:text="ℹ️ Card bắt hình AFN_CAP (VID: ff02 / PID: afa1) được nhận diện tự động."
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- CARD 3: TỰ ĐỘNG HÓA SỐ LÙI (GEAR R) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. TỰ ĐỘNG HÓA SỐ LÙI (GEAR R)"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Toggle Auto Reverse -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tự bật khi vào số Lùi (R)"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhận diện tín hiệu số R tức thì"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchReverseGear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Toggle Immediate Close on P/D -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tự ẩn / tắt ngay khi về P hoặc D"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Không đè lên Maps, Be, Grab khi chạy"
                            android:textColor="#34C759"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchImmediateClose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Park Assist Sonar Sound Beep -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Âm thanh cảnh báo khoảng cách (Beep)"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiếng bíp bíp tăng tốc khi vào vạch đỏ"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchParkAssist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Night Booster Low Light Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cân bằng sáng ban đêm (Night Booster)"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tăng tương phản &amp; độ sáng khi lùi hẻm tối"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNightBooster"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kiểm tra tín hiệu số R:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnSimulateReverseOn"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#FF3B30"
                        android:text="Vào số R (Mở)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnSimulateReverseOff"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#2D3748"
                        android:text="Về P/D (Đóng)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2: 3 CARDS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- CARD 4: VẠCH CĂN LÙI & ĐÁNH LÁI -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. VẠCH CĂN LÙI &amp; ĐÁNH LÁI"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Guidelines Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hiển thị Vạch căn lùi"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chuẩn mốc 0.5m, 1.0m, 1.5m"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchGuidelines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Invert Steering Direction -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đảo chiều uốn cong khi lái"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chỉnh ngược hướng cua xe"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchInvertSteering"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Guideline Style Selector Buttons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mẫu vạch kẻ (Style):"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button
                        android:id="@+id/btnStyleSport"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="Sport OEM"
                        android:textSize="9.5sp"
                        android:padding="0dp" />
                    <Button
                        android:id="@+id/btnStylePorsche"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:text="Porsche GT"
                        android:textSize="9.5sp"
                        android:padding="0dp" />
                    <Button
                        android:id="@+id/btnStyleAudi"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="Audi Matrix"
                        android:textSize="9.5sp"
                        android:padding="0dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btnStyleTesla"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:text="Tesla Cyber"
                        android:textSize="9.5sp"
                        android:padding="0dp" />
                    <Button
                        android:id="@+id/btnStyleMaybach"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:text="Maybach Gold"
                        android:textSize="9.5sp"
                        android:padding="0dp" />
                </LinearLayout>

                <!-- Guideline Size Selector Buttons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kích thước vạch lùi (Độ to rõ):"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnScaleNormal"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="Chuẩn"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:strokeColor="#334155" />
                    <Button
                        android:id="@+id/btnScaleLarge"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:backgroundTint="#00E5FF"
                        android:text="To Rõ"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnScaleWide"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="Cực đại"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:strokeColor="#334155" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 5: NÚT CAMERA NỔI (QUICK POPUP) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. NÚT CAMERA NỔI (POPUP)"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Floating Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nút nổi trên màn hình DeX"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Avatar xe chữ R thao tác nhanh"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchFloating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRestartFloating"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="Khởi động lại Nút nổi"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    app:strokeColor="#00E5FF"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnResetFloatingPos"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="Đặt lại vị trí nút về mép trái"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- CARD 6: THÔNG TIN HỆ THỐNG & ĐỘC LẬP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. TRẠNG THÁI HỆ THỐNG"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Nền tảng: Độc lập 100% (Không qua Launcher)"
                    android:textColor="#34C759"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Nhận diện số R: Broadcast Intent &amp; DeX Window"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Môi trường: Samsung DeX / Fold 2"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvBuildVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Bản dựng: TigerIQ Camera v1.0.25"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <!-- KẾT NỐI PC01 / CẬP NHẬT TỰ ĐỘNG -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="KẾT NỐI PC01 / CẬP NHẬT TỰ ĐỘNG"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOnlineStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa kết nối với PC01"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="5dp" />

                <EditText
                    android:id="@+id/editOnlinePairCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mã ghép đôi PC01 (9 chữ số, dùng một lần)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:inputType="number"
                    android:maxLength="9"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnPairOnline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="KẾT NỐI PC01"
                        android:textSize="11sp" />
                    <Button
                        android:id="@+id/btnSyncOnline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="GỬI LOG NGAY"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnCheckOnlineUpdate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="KIỂM TRA BẢN MỚI"
                        android:textSize="11sp" />
                    <Button
                        android:id="@+id/btnInstallOnlineUpdate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="CÀI BẢN ĐÃ TẢI"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sau khi ghép đôi: tự gửi log qua HTTPS và tự tải bản mới. Android yêu cầu xác nhận cài."
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp" />

                <!-- LỊCH SỬ LOG HOẠT ĐỘNG -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="LỊCH SỬ LOG HOẠT ĐỘNG (DIAGNOSTICS)"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraEventLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhật ký chưa tải. Nhấn XEM LOG."
                    android:textSize="11sp"
                    android:maxLines="18"
                    android:textIsSelectable="true"
                    android:textColor="#E2E8F0"
                    android:background="#0F172A"
                    android:padding="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnRefreshCameraLog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="XEM LOG"
                        android:textSize="11sp" />
                    <Button
                        android:id="@+id/btnShareCameraLog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="CHIA SẺ LOG"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Được chứng nhận bởi TigerIQ AI Lab."
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
