<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cameraOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_camera_overlay_window"
    android:clipToOutline="true"
    android:elevation="12dp">

    <!-- UVC Camera Video Texture -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Reconstructed V1/V2 Dynamic Guidelines Canvas -->
    <ai.tigeriq.camera.DynamicGuideView
        android:id="@+id/dynamicGuideView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Drag / Title Bar -->
    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top"
        android:background="#CC0A0E17"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvGearBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFFF3B30"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="R"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Camera UVC đang hoạt động"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Top Close Button -->
        <ImageButton
            android:id="@+id/btnCloseTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng cửa sổ"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFF3B30" />
    </LinearLayout>

    <!-- Center Card: Interactive Permission Prompt (When USB or Camera permission is needed) -->
    <LinearLayout
        android:id="@+id/cardPermissionPrompt"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_setting_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPromptTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CẦN CẤP QUYỀN CAMERA &amp; USB"
            android:textColor="@color/cyan_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPromptDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Đã phát hiện thiết bị Camera UVC. Vui lòng bấm nút để cấp quyền."
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantUsb"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cyan_accent"
            android:text="BẤM CẤP QUYỀN USB"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Quick Control Bar -->
    <LinearLayout
        android:id="@+id/bottomToolBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_camera_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp">

        <!-- Toggle Guidelines / Cycle Style -->
        <ImageButton
            android:id="@+id/btnToggleGuide"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đổi kiểu vạch lùi"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@color/cyan_accent" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="6dp"
            android:background="#33FFFFFF" />

        <!-- Night Booster (Low Light Enhancement) -->
        <ImageButton
            android:id="@+id/btnNightBooster"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chế độ ban đêm"
            android:src="@drawable/ic_night_vision"
            android:tint="@color/white" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="6dp"
            android:background="#33FFFFFF" />

        <!-- Park Assist Sonar Sound Beep -->
        <ImageButton
            android:id="@+id/btnToggleSound"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Âm thanh cảnh báo khoảng cách"
            android:src="@drawable/ic_sound_beep"
            android:tint="@color/cyan_accent" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="6dp"
            android:background="#33FFFFFF" />

        <!-- Settings / Permission Center -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cài đặt"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="@color/white" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="6dp"
            android:background="#33FFFFFF" />

        <!-- Close / Exit -->
        <ImageButton
            android:id="@+id/btnCloseBottom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng Camera"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/white" />
    </LinearLayout>

</FrameLayout>
