{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/pc01-view?target=dashboard"
    },
    {
      "source": "/command-center",
      "destination": "/api/pc01-view?target=dashboard"
    },
    {
      "source": "/index",
      "destination": "/api/pc01-view?target=dashboard"
    },
    {
      "source": "/workforce",
      "destination": "/api/pc01-view?target=dashboard"
    },
    {
      "source": "/projects",
      "destination": "/api/pc01-view?target=dashboard"
    },
    {
      "source": "/work-center.js",
      "destination": "/api/pc01-view?target=workjs"
    },
    {
      "source": "/work-ui.css",
      "destination": "/api/pc01-view?target=workcss"
    },
    {
      "source": "/work-center-visual.css",
      "destination": "/api/pc01-view?target=visualcss"
    },
    {
      "source": "/api/status",
      "destination": "/api/pc01-view?target=status"
    },
    {
      "source": "/api/health-live-work",
      "destination": "/api/pc01-view?target=work"
    },
    {
      "source": "/api/work-history",
      "destination": "/api/pc01-view?target=history"
    },
    {
      "source": "/api/live-status",
      "destination": "/api/pc01-view?target=live"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/command-center",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/workforce",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/projects",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
