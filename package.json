{
  "name": "tigeriq-ai-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-driven AI development control center",
  "engines": { "node": ">=22" },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run validate:schemas && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
