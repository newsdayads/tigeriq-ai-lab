{
  "name": "tigeriq-ai-lab",
  "version": "0.9.0",
  "private": true,
  "description": "Evidence-gated distributed AI workforce control center",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:chief": "node scripts/test-chief-router.mjs",
    "build": "node scripts/p0-gateway-build-diagnostic.mjs && tsc -p tsconfig.build.json",
    "command-center": "node dist/apps/dashboard/src/standalone.js",
    "workforce-controller": "node dist/apps/workforce-controller/src/standalone.js",
    "ci": "npm run typecheck && npm run test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@vercel/oidc": "3.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
