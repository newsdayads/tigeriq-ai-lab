{
  "name": "tigeriq-ai-lab",
  "version": "0.9.0",
  "private": true,
  "description": "Evidence-gated multi-agent AI development control center",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.build.json",
    "command-center": "node dist/apps/dashboard/src/standalone.js",
    "workforce-controller": "node dist/apps/workforce-controller/src/standalone.js",
    "pc01-native-worker": "node dist/apps/pc01-native-worker/src/standalone.js",
    "autonomous-planner": "node dist/apps/autonomous-planner/src/standalone.js",
    "ci": "npm run typecheck && npm run test && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
