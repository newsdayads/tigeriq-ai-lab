{
  "manifest_version": 3,
  "name": "TigerIQ Auto Worker",
  "version": "14.0.0",
  "description": "TigerIQ multi-employee Auto Worker — registry-driven scheduler, leases, resource governor, NV01 yield and verified archive lifecycle.",
  "permissions": ["storage", "tabs", "windows", "alarms", "scripting", "system.display", "system.cpu", "system.memory"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "tigeriq_aw_bg.js"},
  "action": {"default_title":"TigerIQ Auto Worker","default_popup":"tigeriq_aw_popup.html","default_icon":{"16":"tigeriq_icon_16.png","32":"tigeriq_icon_32.png","48":"tigeriq_icon_48.png","128":"tigeriq_icon_128.png"}},
  "icons": {"16":"tigeriq_icon_16.png","32":"tigeriq_icon_32.png","48":"tigeriq_icon_48.png","128":"tigeriq_icon_128.png"},
  "content_scripts": [{"matches":["https://chatgpt.com/*"],"js":["tigeriq_aw_runtime.js"],"run_at":"document_idle"}]
}
